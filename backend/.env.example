APP_NAME=EduSync API
APP_ENV=development
API_V1_PREFIX=/api/v1

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Backend only. Required for inviting users and provisioning profiles/memberships.
# Never put this in frontend/.env.local or any NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

SUPABASE_INVITE_REDIRECT_URL=http://localhost:3000/auth/accept-invite
